# =============================================================================
# WA OTP — Self-Hosted Configuration (.env.example)
#
# Copy this file to `.env` before running `docker compose up -d`:
#
#     cp .env.example .env
#
# NEVER commit your filled-in `.env`. Everything configured here belongs to YOU:
# your server, your database, your Meta developer account, and your phone number.
# There is NO hosted service, NO shared account, and NO telemetry.
# =============================================================================

# --- 1. Application Identity -------------------------------------------------
APP_NAME="WA OTP"
# Set to 'production' for live deployment. In production, the backend will refuse
# to start if WAOTP_FERNET_KEY, SECRET_KEY or PB_SUPERUSER_PASSWORD are missing.
APP_ENV=development

# Public URL of your API gateway (without trailing slash).
# Must be YOUR host — this is what your Meta webhook URL is derived from, and
# Meta has to be able to reach it. Local development is the default so that a
# copy of this file is never silently pointed at somebody else's server.
# Example for a real install: https://api.yourdomain.com
APP_URL=http://localhost:8000
API_URL=http://localhost:8000

# General-purpose cryptographic secret for signing. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- 2. PocketBase Database & Control Plane ----------------------------------
# Internal connection URL. Inside Docker Compose, the API container connects to
# pocketbase:8090. For local host development outside Docker, use http://127.0.0.1:8090.
PB_URL=http://127.0.0.1:8090

# Superuser credentials used by the API to manage control plane records.
# Choose an email and a strong password (minimum 8 characters).
PB_SUPERUSER_EMAIL=admin@yourdomain.com
PB_SUPERUSER_PASSWORD=

# Physical collection name prefix (default: waotp_).
# Allows sharing one PocketBase instance across projects without name collisions.
WAOTP_PB_COLLECTIONS_PREFIX=waotp_

# --- 3. Encryption & Secrets -------------------------------------------------
# Fernet 32-byte url-safe base64 key used to encrypt Meta access tokens at rest
# in the database and sign Telegram link tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WAOTP_FERNET_KEY=

# Shared secret Telegram echoes back in X-Telegram-Bot-Api-Secret-Token.
# Generated automatically when running scripts/set_telegram_webhook.py.
TELEGRAM_WEBHOOK_SECRET=

# --- 4. Dashboard & CORS -----------------------------------------------------
# Allowed browser origin for the Next.js dashboard. Required for CORS.
# Example: https://otp-dashboard.yourdomain.com (or http://localhost:3000 for dev)
DASHBOARD_ORIGIN=http://localhost:3000

# Keep 0 for self-hosted instances. When 0, public registration is disabled;
# create your operator account using: docker compose exec api python scripts/create_admin.py you@example.com
ALLOW_SIGNUP=0

# --- 5. WhatsApp Provider (Meta WhatsApp Cloud API) --------------------------
# Provider implementation: 'meta' (Meta WhatsApp Cloud API).
WHATSAPP_PROVIDER=meta

# From your Meta Developer App (WhatsApp -> API Setup):
# Your WhatsApp Business Phone Number ID:
META_PHONE_NUMBER_ID=

# Your WhatsApp Business Account ID (WABA ID):
META_BUSINESS_ACCOUNT_ID=
META_WABA_ID=

# Meta System User Access Token (with whatsapp_business_messaging permission):
META_ACCESS_TOKEN=

# WhatsApp Template name and language approved in your Meta WhatsApp Manager:
META_TEMPLATE=verification_code
META_TEMPLATE_LANG=en_US

# Webhook Verification Token: You choose this random string and paste the exact
# same string into your Meta App Webhook configuration.
META_VERIFY_TOKEN=

# Meta App Secret (App Settings -> Basic in Meta developer portal).
# Used to verify SHA256 HMAC signature on inbound webhook delivery callbacks.
META_APP_SECRET=

# Meta Graph API version & base URL
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# --- 6. Telegram Channel (Alternative / Backup) -----------------------------
# Bot token created via @BotFather on Telegram (optional if only using WhatsApp):
TELEGRAM_BOT_TOKEN=

# Bot username WITHOUT leading '@' (e.g. my_otp_bot):
TELEGRAM_BOT_USERNAME=

# --- 7. OTP Policy & Delivery Defaults ---------------------------------------
# Digits in generated OTP (min: 4, max: 10, default: 6):
OTP_LENGTH=6

# Default country calling code for national numbers without '+' (default: 91):
DEFAULT_COUNTRY_CODE=91

# How long OTP codes remain valid in seconds (default: 300 = 5 minutes):
OTP_EXPIRATION_SECONDS=300
CODE_TTL_SECONDS=300

# Maximum incorrect attempts before an OTP is burned (default: 3):
MAX_ATTEMPTS=3

# Monthly send quota cap for WhatsApp messages (0 = unlimited).
# Acts as a runaway-spend guard against your own Meta WhatsApp account:
MONTHLY_SEND_QUOTA=500

# Maximum OTP sends allowed to a single phone number per hour (default: 5):
PER_PHONE_HOURLY=5

# Minimum cooldown gap between resend requests to same phone in seconds (0 = disabled):
RESEND_COOLDOWN_SECONDS=0

# --- 8. Abuse Prevention & Rate Limiting -------------------------------------
RATE_LIMIT_ENABLED=1

# Maximum API requests per minute per API key:
OTP_RATE_LIMIT=10
RATELIMIT_PER_MIN=10

# Maximum API requests per minute per client IP address:
RATELIMIT_PER_IP_PER_MIN=30

# Only set to 1 if running behind a reverse proxy (Nginx/Caddy/Traefik) that
# overwrites X-Forwarded-For:
TRUST_PROXY_HEADERS=0

# --- 9. Local Development & Testing ------------------------------------------
# Set to 1 to simulate WhatsApp/Telegram delivery without calling Meta/Telegram.
# MUST be 0 in production:
WAOTP_MOCK_DELIVERY=1

# --- 10. Frontend Public Build Variables (For Docker Compose) -----------------
# Public URLs reachable by the end-user's browser (compiled into frontend bundle):
NEXT_PUBLIC_PB_URL=http://localhost:8090
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PB_COLLECTIONS_PREFIX=waotp_
# Optional GitHub repository (e.g. owner/repo) to display star count:
NEXT_PUBLIC_GITHUB_REPO=
# Telemetry is disabled by default:
NEXT_PUBLIC_SENTRY_DISABLED=true
