# WA OTP dashboard — copy to .env.local and point it at YOUR OWN services:
#
#     cp frontend/.env.local.example frontend/.env.local
#
# These values are compiled into the browser bundle, so every one of them is
# public by design. There are no secrets in this file: never put an API key,
# a Meta token or a bot token here. `NEXT_PUBLIC_*` is inlined at build time,
# so changing a value needs a rebuild — not just a restart.

# Your own PocketBase instance. It is the data store and the auth source of
# truth for the dashboard.
#
# There is deliberately no fallback value in the code: if this is unset the app
# raises a configuration error instead of quietly talking to somebody else's
# server while looking like it works.
NEXT_PUBLIC_PB_URL=http://127.0.0.1:8090

# Collection namespace. Must match WAOTP_PB_COLLECTIONS_PREFIX in backend/.env
# (default `waotp_`). It lets one PocketBase instance host this app alongside
# other projects without name collisions; for a dedicated instance the default
# is correct. Never leave it empty against a shared instance — an unprefixed
# build would address that project's stock `users` and `api_keys` collections.
NEXT_PUBLIC_PB_COLLECTIONS_PREFIX=waotp_

# Your FastAPI backend base URL (the hot path). Local dev: port 8000.
# For production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical origin of this dashboard. Used as the PocketBase password-reset
# return address, so it must be the origin users actually reach. Set it per
# environment rather than relying on window.location.origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: `owner/repo` of this project on GitHub.
# When set, the landing nav shows a live star count (api.github.com, cached for
# an hour) and the footer grows a github link. When unset, both surfaces render
# nothing — no placeholder link and no invented count.
#
# Because there is no default, a fork shows no GitHub chrome until its own
# maintainer sets this. That is the intended behaviour.
# NEXT_PUBLIC_GITHUB_REPO=owner/repo

# Optional: a disposable-inbox service to suggest on the login screen and the
# dashboard overview, for testing without burning a real email address.
#
# Deliberately unset. This project bakes in no third-party link, so a
# self-hoster's login page never sends their operators to a service the project
# authors happen to run. Point it at your own provider to turn the prompt on;
# leave it unset and nothing renders — no placeholder, no dead link.
# NEXT_PUBLIC_TEMP_MAIL_URL=https://your-inbox.example.com/

# Optional error reporting. The project ships with no telemetry and nothing is
# sent anywhere unless you set a DSN yourself — and even then it reports to
# YOUR Sentry project, never to the authors'. Leave unset to keep Sentry inert.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ORG=
# NEXT_PUBLIC_SENTRY_PROJECT=
# NEXT_PUBLIC_SENTRY_DISABLED=true
