# ---------------------------------------------------------------------------
# WOTP — backend configuration
#
# Copy this file to `backend/.env` and fill in your own values:
#
#     cp backend/.env.example backend/.env
#
# `.env` is gitignored. NEVER commit a filled-in copy, and never paste real
# tokens into `.env.example` — this file is the template that ships to everyone.
#
# Everything here belongs to YOU: your PocketBase, your Meta app, your bot.
# There are no shared credentials and nothing to request from the authors.
# ---------------------------------------------------------------------------

# --- Application identity ---------------------------------------------------
# `development` or `production`.
#
# In `production` the app REFUSES TO START unless WOTP_FERNET_KEY,
# SECRET_KEY and PB_SUPERUSER_PASSWORD are set and WOTP_MOCK_DELIVERY is 0.
# That is deliberate: booting with a weakened default would be worse than not
# booting at all.
APP_ENV=development

# Public origin of THIS api, no trailing slash. Used to show your webhook URL
# in the dashboard and docs. Local development is the default so a copy of
# this file is never silently pointed at somebody else's server.
# Example for a real install: https://api.yourdomain.com
# Your Meta webhook URL is derived from it: ${APP_URL}/webhooks/whatsapp
APP_URL=http://localhost:8000

# General-purpose signing secret. Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- PocketBase control plane ----------------------------------------------
# Your own PocketBase instance. It is the data store and the auth source of
# truth for the dashboard, and it is never exposed to your end users.
PB_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Prefix prepended to every collection this app owns: users -> waotp_users,
# api_keys -> waotp_api_keys, and so on. It exists so one PocketBase instance
# can host this app alongside other projects without name collisions. For a
# PocketBase dedicated to this app the default is correct and you never have
# to think about it. Must match NEXT_PUBLIC_PB_COLLECTIONS_PREFIX in the
# frontend.
WOTP_PB_COLLECTIONS_PREFIX=waotp_

# --- Secrets ----------------------------------------------------------------
# Encrypts provider tokens at rest in the PocketBase `settings` row, and signs
# Telegram link tokens. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes previously stored tokens unreadable — re-enter the
# Meta and Telegram credentials after rotating.
WOTP_FERNET_KEY=

# Shared secret Telegram echoes back in X-Telegram-Bot-Api-Secret-Token. Must
# equal the secret_token passed to setWebhook; scripts/set_telegram_webhook.py
# sets both.
TELEGRAM_WEBHOOK_SECRET=

# --- Dashboard --------------------------------------------------------------
# CORS origin of YOUR Next.js dashboard, e.g. https://otp-dashboard.example.com
# (http://localhost:3000 for local dev.) Without this the browser blocks every
# dashboard call to the API, and it presents as a dead backend rather than a
# config error.
DASHBOARD_ORIGIN=

# NOTE: there is no signup variable here, on purpose. Whether an account can
# be self-registered is decided by the PocketBase auth collection's create
# rule, not by this process — see docs/self-hosting.md. It is created
# operator-only, so the first account comes from:
#   .venv/bin/python scripts/create_admin.py you@example.com

# --- WhatsApp provider ------------------------------------------------------
# Which implementation delivers WhatsApp OTPs. Only `meta` exists today (the
# Meta WhatsApp Cloud API). Telegram is a separate built-in channel and is
# configured by its own bot token below.
WHATSAPP_PROVIDER=meta

# From your own Meta app: WhatsApp -> API Setup.
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Temporary (24h) or System User token from your own app. Stored
# Fernet-encrypted when set through the dashboard; treat the .env copy as a
# secret too.
META_ACCESS_TOKEN=

META_TEMPLATE=verification_code
META_TEMPLATE_LANG=en_US

# You choose this string and paste the identical value into your Meta app's
# webhook configuration. Meta echoes it back during the GET verification
# handshake; requests carrying the wrong value are rejected.
META_VERIFY_TOKEN=

# Your Meta app's secret (App settings -> Basic). Validates the
# X-Hub-Signature-256 header on every inbound webhook POST.
#
# REQUIRED in production whenever WhatsApp credentials are set above: without
# it the app refuses to start, because unsigned callbacks mean anyone who
# learns your webhook URL can forge delivery statuses. Empty is only tolerated
# in development, and GET /health/ready reports it there rather than hiding it.
META_APP_SECRET=

# Optional. While testing against Meta's own sandbox number you send with
# Meta's sample template, which takes THREE body parameters instead of the one
# a normal authentication template takes. Put that template's exact name here
# and this app will use the sandbox shape for it; leave empty otherwise.
# META_SANDBOX_TEMPLATE=

# Graph API version. Credentials and template payloads are version-specific,
# so this is configuration, not a constant baked into the code.
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# --- Telegram channel -------------------------------------------------------
# Bot token from @BotFather. This is the ONLY thing Telegram needs — no business
# verification, no credit card, no template approval.
#
# Telegram does not bill for bot API messages. Your server does, and that cost
# is yours; nothing here makes hosting free.
TELEGRAM_BOT_TOKEN=

# Bot username WITHOUT the leading "@" (e.g. my_otp_bot). Used to build the
# t.me deep link a user taps to link their number to your bot. Required for
# Telegram: without it, a send to an unlinked number cannot tell the user where
# to go.
TELEGRAM_BOT_USERNAME=

# --- OTP policy -------------------------------------------------------------
# These are FALLBACKS. The single row in the PocketBase `settings` collection
# wins when set, so you can retune any of these from the admin UI without a
# redeploy.
OTP_LENGTH=6

# Country code assumed for a bare national number (digits only, no "+").
# Self-hosters are not all in one country, so it is not baked in.
DEFAULT_COUNTRY_CODE=91

# How long a code stays valid.
CODE_TTL_SECONDS=300
# Wrong guesses allowed before the code is burned.
MAX_ATTEMPTS=3

# Monthly cap on WhatsApp-delivered sends for the whole installation.
# 0 means unlimited. Telegram is never counted against it.
#
# You are sending from your own Meta account, so this is a runaway-spend guard
# you choose to set — not a tier imposed by anyone. Failed sends never consume
# it, and only successful WhatsApp deliveries count.
MONTHLY_SEND_QUOTA=500

# Sends to one phone number per hour, across both channels.
PER_PHONE_HOURLY=5
# Minimum gap between two sends to the same number, in seconds. 0 disables it.
RESEND_COOLDOWN_SECONDS=0

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=1

# Per API key, per minute.
RATELIMIT_PER_MIN=10

# Per client IP, per minute. This is what stops an unauthenticated caller — or
# a leaked key — from turning your installation into a bulk WhatsApp spam
# gateway.
RATELIMIT_PER_IP_PER_MIN=30

# Only enable behind a reverse proxy you control. When true, the per-IP
# limiter reads the RIGHT-MOST X-Forwarded-For entry (the one your proxy
# appended) and only if it parses as an IP address. Leave 0 unless you know
# your proxy does not forward a client-supplied header verbatim.
TRUST_PROXY_HEADERS=0

# --- Local development only -------------------------------------------------
# Fakes provider delivery while keeping every database row real, so the whole
# send -> verify -> quota flow runs with no Meta account and no bot. MUST be 0
# or absent in production; the app refuses to start in production with it on.
WOTP_MOCK_DELIVERY=1
