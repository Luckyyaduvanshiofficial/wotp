# =============================================================================
# WOTP — Dokploy production environment (.env.production)
# =============================================================================
#
# Paste this whole file into Dokploy → your Compose project → Environment.
# Every value here feeds docker-compose.dokploy.yml.
#
# Generate the three secrets with:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"                 # SECRET_KEY, TELEGRAM_WEBHOOK_SECRET, META_VERIFY_TOKEN
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   # WOTP_FERNET_KEY
#
# WOTP_FERNET_KEY MUST be a valid Fernet key (44 URL-safe base64 chars). If it is
# malformed the API boots and then fails on the first token write; if you LOSE it
# after storing a Meta token, that ciphertext is unrecoverable and you have to
# re-enter the token.
#
# Lines marked  [YOU]  are the only ones you must supply yourself.
# =============================================================================

# --- 1. Identity -------------------------------------------------------------
# Fixed at `production` by docker-compose.dokploy.yml. It is listed here so
# the file is self-describing, but editing it will not change the deployment
# — this is the production compose file, so production is not a choice it
# offers.
#
# production switches on the API's pre-flight check: it REFUSES TO START unless
# SECRET_KEY, WOTP_FERNET_KEY, PB_SUPERUSER_PASSWORD are set and mock delivery is
# off. Leave this exactly as it is.
APP_ENV=production
APP_NAME=WOTP

# [YOU] Public URL of the API. Meta derives your webhook URL from this and must
# be able to reach it. No trailing slash.
#   https://api.otp.example.com
APP_URL=

# [YOU] Public origin the dashboard is served from. Must match exactly, or every
# dashboard request fails CORS and looks like a dead backend.
#   https://otp.example.com
DASHBOARD_ORIGIN=

# --- 2. Secrets --------------------------------------------------------------
# [YOU] 48+ random characters. Signs session and link tokens.
SECRET_KEY=

# [YOU] Fernet key. Encrypts the Meta access token at rest and signs Telegram
# link tokens. Rotating it means re-entering the Meta token in the dashboard.
WOTP_FERNET_KEY=

# --- 3. PocketBase -----------------------------------------------------------
# The password is used ONCE, to create the superuser on a fresh volume. After
# that it is ignored, so changing it here will not change an existing superuser.
# Minimum 8 characters; PocketBase enforces it and the container exits if unmet.
PB_SUPERUSER_EMAIL=admin@yourdomain.com
PB_SUPERUSER_PASSWORD=

# Physical table prefix. Leave at the default unless this is a brand new install
# and you specifically want a different namespace. Changing it on an install that
# already holds data points the app at empty tables.
WOTP_PB_COLLECTIONS_PREFIX=waotp_

# --- 4. WhatsApp (Meta WhatsApp Cloud API) -----------------------------------
# Optional: leave every Meta value blank to run Telegram-only.
WHATSAPP_PROVIDER=meta

# [YOU] From Meta → your app → WhatsApp → API Setup.
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=

# [YOU] You invent this string, then paste the same string into the Meta app's
# webhook configuration. Anything random and long will do.
META_VERIFY_TOKEN=

# [YOU] Meta → App Settings → Basic → App Secret. Signs inbound webhook
# callbacks. REQUIRED as soon as any credential above is set: without it the API
# refuses to boot, because unverified callbacks let anyone forge message
# statuses and those feed a control-plane query.
META_APP_SECRET=

# Template approved in Meta WhatsApp Manager. Language must match the approval.
META_TEMPLATE=verification_code
META_TEMPLATE_LANG=en_US
# Only for Meta's sandbox test number, which cannot use a custom template.
# Leave blank in production.
META_SANDBOX_TEMPLATE=
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# --- 5. Telegram -------------------------------------------------------------
# Optional alternative channel. Needs no business verification and no card.
# [YOU] Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# [YOU] Bot username WITHOUT the leading '@'.
TELEGRAM_BOT_USERNAME=
# [YOU] Random string. Telegram echoes it back so the webhook can reject
# strangers. Register it after the first deploy:
#   docker compose exec api python scripts/set_telegram_webhook.py
TELEGRAM_WEBHOOK_SECRET=

# --- 6. OTP policy -----------------------------------------------------------
OTP_LENGTH=6
DEFAULT_COUNTRY_CODE=91
CODE_TTL_SECONDS=300
MAX_ATTEMPTS=3
PER_PHONE_HOURLY=5
RESEND_COOLDOWN_SECONDS=0
# Runaway-spend guard against YOUR OWN Meta account. 0 = unlimited.
MONTHLY_SEND_QUOTA=500

# --- 7. Abuse prevention -----------------------------------------------------
RATE_LIMIT_ENABLED=1
RATELIMIT_PER_MIN=10
RATELIMIT_PER_IP_PER_MIN=30
# 1 is correct behind Dokploy: Traefik terminates TLS and sets X-Forwarded-For.
# With 0, every request appears to come from the proxy and the per-IP limiter
# collapses into a single shared bucket.
#
# Also fixed at 1 by the compose file; listed for the same reason as APP_ENV.
TRUST_PROXY_HEADERS=1

# --- 8. Delivery -------------------------------------------------------------
# MUST stay 0 in production. 1 fakes every send while reporting success, and the
# API refuses to boot with it on under APP_ENV=production.
#
# Fixed at 0 by the compose file. That is not the only guard: the API itself
# refuses to start with APP_ENV=production and this on, so even a hand-edited
# compose cannot ship a production install that silently sends nothing.
WOTP_MOCK_DELIVERY=0

# --- 9. Frontend build arguments --------------------------------------------
# These are compiled into the browser bundle at BUILD time, so a change here
# requires a REBUILD in Dokploy, not a restart. They must be URLs a BROWSER can
# reach — never `http://api:8000`, which resolves only between containers.
#
# [YOU] All three, matching the domains you attach in Dokploy.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_PB_URL=

# Optional: renders a GitHub link and star count on the landing page.
NEXT_PUBLIC_GITHUB_REPO=Luckyyaduvanshiofficial/wotp
# Error reporting. Leave true and nothing is reported anywhere. To opt in, set
# this to an empty value AND add your own Sentry DSN — it reports to your
# project, never to the authors'.
NEXT_PUBLIC_SENTRY_DISABLED=true
