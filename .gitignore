# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets. `*` is deliberate: a bare `.env` rule does NOT match
# `frontend/.env.local`, which is exactly the file a Next.js contributor
# creates first and the one most likely to hold a real token.
.env*
!.env.example
!.env.local.example

# PocketBase runtime data (backups are non-negotiable — see PRD §10)
backend/pocketbase/pb_data/

# The PocketBase server binary itself: platform-specific and ~40 MB, so every
# clone would pay for a build that only runs on linux/amd64. Download it from
# https://github.com/pocketbase/pocketbase/releases and drop it next to
# pb_migrations/ — see backend/README.md.
backend/pocketbase/pocketbase

# OS / editor
.DS_Store

# Frontend (future Next.js work)
node_modules/
.next/
.vercel/

# Graphify generated artifacts
graphify-out/

# Local AI-tooling state. Not project source, and `.claude/settings.local.json`
# can hold machine-local permission allowlists — none of this belongs in a
# public repo. Re-installable per machine, so there is nothing to lose.
.claude/
.agents/
.commandcode/
.hallmark/
.zcode/
.v2c/

# Loose font downloads dropped into the repository root. Fonts the design
# actually uses live in frontend/src/fonts/ and are tracked there; a bundle
# sitting in the root is unreferenced and would add megabytes to the history
# for nothing. Extract it somewhere else, or move the specific file into
# frontend/src/fonts/ and wire it up in font.config.ts.
/GeistPixel-*.ttf
/OFL.txt
/README.txt
